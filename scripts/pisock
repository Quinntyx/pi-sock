#!/usr/bin/env node
/**
 * pisock — minimal CLI client for the pi-sock extension.
 *
 * Usage:
 *   pisock send <text> [--mode steer|follow_up] [--wait] [--timeout <ms>]
 *   pisock state
 *   pisock message
 *   pisock abort
 *
 * Socket path: $PI_SOCK (default ~/.pi/pi-sock/main.sock)
 */

import * as net from "node:net";
import * as path from "node:path";
import * as os from "node:os";

const SOCKET =
	process.env.PI_SOCK ?? path.join(os.homedir(), ".pi", "pi-sock", "main.sock");

function usage() {
	console.error(usageText());
	process.exit(2);
}

function usageText() {
	return [
		"usage:",
		"  pisock send <text> [--mode steer|follow_up] [--wait] [--timeout <ms>]",
		"  pisock state",
		"  pisock get-message",
		"  pisock abort",
		"env: PI_SOCK overrides the socket path (default ~/.pi/pi-sock/main.sock)",
	].join("\n");
}

class Client {
	constructor() {
		this.socket = net.createConnection(SOCKET);
		this.socket.setEncoding("utf8");
		this.buffer = "";
		this.pending = [];
		this.socket.on("data", (chunk) => {
			this.buffer += chunk;
			let i = this.buffer.indexOf("\n");
			while (i !== -1) {
				const line = this.buffer.slice(0, i).trim();
				this.buffer = this.buffer.slice(i + 1);
				i = this.buffer.indexOf("\n");
				if (line) this.onLine(JSON.parse(line));
			}
		});
		this.waiters = [];
	}

	onLine(msg) {
		if (msg.type === "response") {
			this.lastResponse = msg;
			this.pending = this.pending.filter((w) => {
				if (w.type === "response" && w.command === msg.command && !w.done) {
					w.done = true;
					w.resolve(msg);
					return false;
				}
				return true;
			});
		} else if (msg.type === "event") {
			for (const w of [...this.pending]) {
				if (w.type === "event" && w.event === msg.event) {
					w.resolve(msg);
					this.pending = this.pending.filter((x) => x !== w);
				}
			}
		}
	}

	send(obj) {
		this.socket.write(`${JSON.stringify(obj)}\n`);
	}

	waitResponse(command) {
		return new Promise((resolve, reject) => {
			this.pending.push({ type: "response", command, resolve, reject });
		});
	}

	waitEvent(event) {
		return new Promise((resolve, reject) => {
			this.pending.push({ type: "event", event, resolve, reject });
		});
	}

	close() {
		this.socket.end();
	}
}

function fail(message) {
	console.error(`pisock: ${message}`);
	process.exit(1);
}

async function main() {
	const argv = process.argv.slice(2);
	const cmd = argv[0];

	if (cmd === "state") {
		const c = new Client();
		c.send({ type: "get_state", id: "cli" });
		const res = await c.waitResponse("get_state");
		console.log(JSON.stringify(res.data, null, 2));
		c.close();
		return;
	}

	if (cmd === "get-message") {
		const c = new Client();
		c.send({ type: "get_message", id: "cli" });
		const res = await c.waitResponse("get_message");
		console.log(JSON.stringify(res.data, null, 2));
		c.close();
		return;
	}

	if (cmd === "abort") {
		const c = new Client();
		c.send({ type: "abort", id: "cli" });
		const res = await c.waitResponse("abort");
		console.log(JSON.stringify(res));
		c.close();
		return;
	}

	if (cmd === "send") {
		const args = argv.slice(1);
		const textParts = [];
		let mode = "steer";
		let wait = false;
		let timeout = 10_000;
		for (let i = 0; i < args.length; i++) {
			const a = args[i];
			if (a === "--mode") mode = args[++i];
			else if (a === "--wait") wait = true;
			else if (a === "--timeout") timeout = Number(args[++i]);
			else textParts.push(a);
		}
		const text = textParts.join(" ").trim();
		if (!text) usage();

		const c = new Client();
		// Subscribe first so no settle slips between the ack and the subscription.
		if (wait) {
			c.send({ type: "subscribe", events: ["agent_settled"], id: "sub" });
			await c.waitResponse("subscribe");
		}
		c.send({ type: "send", text, mode, id: "req" });
		const res = await c.waitResponse("send");
		if (!res.success) fail(`send rejected: ${res.error}`);
		console.error(`accepted (mode=${res.data.mode})`);

		if (!wait) {
			c.close();
			return;
		}

		const settled = await Promise.race([
			c.waitEvent("agent_settled"),
			new Promise((_, reject) =>
				setTimeout(() => reject(new Error(`no agent_settled within ${timeout}ms`)), timeout),
			),
		]);
		const msg = settled.data?.lastAssistant;
		console.log(msg ? msg.content : "(no assistant message)");
		c.close();
		return;
	}

	usage();
}

process.on("unhandledRejection", (err) => fail(err?.message ?? String(err)));

main().catch((err) => fail(err?.message ?? String(err)));
